#!/bin/bash
# Ralph entry point - invokes Python CLI
#
# Usage: .claude/ralph/ralph run <prd-path> <plan-path> [options]
#
# This is a thin wrapper that invokes the Python implementation.
# Requires Python 3.10+ to be installed.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Load .env file if it exists
if [ -f "$PROJECT_ROOT/.env" ]; then
    set -a
    source "$PROJECT_ROOT/.env"
    set +a
fi

# Check Python version
if ! python3 -c "import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)" 2>/dev/null; then
    echo "Error: Python 3.10 or higher is required" >&2
    exit 1
fi

# Check dependencies from requirements.txt
MISSING_DEPS=""
while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip comments and empty lines
    [[ "$line" =~ ^#.*$ || -z "$line" ]] && continue
    # Extract package name (strip version specifiers like >=, ==, etc.)
    pkg=$(echo "$line" | sed 's/[<>=!].*//' | tr -d '[:space:]')
    [[ -z "$pkg" ]] && continue
    # Check if package is installed
    if ! pip show "$pkg" >/dev/null 2>&1; then
        MISSING_DEPS="$MISSING_DEPS $pkg"
    fi
done < "$SCRIPT_DIR/requirements.txt"

if [ -n "$MISSING_DEPS" ]; then
    echo "Missing required dependencies:$MISSING_DEPS" >&2
    echo "" >&2
    echo "Install with:" >&2
    echo "  pip install -r $SCRIPT_DIR/requirements.txt" >&2
    exit 1
fi

# Add the ralph directory to PYTHONPATH so imports like "from core.X" work
export PYTHONPATH="$SCRIPT_DIR:$PYTHONPATH"

# Run the CLI directly
exec python3 "$SCRIPT_DIR/cli.py" "$@"
