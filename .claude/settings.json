{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Grep",
      "Glob",
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(dd if=/dev/zero of=/dev/sda)",
      "Bash(mkfs.ext4 /dev/sda)",
      "Bash(> /dev/sda)",
      "Bash(fork bomb)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": ".claude/scripts/statusline.sh"
  },
  "alwaysThinkingEnabled": true
}
