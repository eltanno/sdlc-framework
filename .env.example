# SDLC Framework Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: This file contains SECRETS - never commit .env to git
# Project preferences (non-secret) go in config.yaml

# =============================================================================
# Asana (when config.yaml has pm.tool: asana)
# =============================================================================
# Get your token at: https://app.asana.com/0/developer-console
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_ID=
ASANA_PROJECT_ID=

# =============================================================================
# Trello (when config.yaml has pm.tool: trello)
# =============================================================================
# Get API key at: https://trello.com/app-key
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_BOARD_ID=

# =============================================================================
# Linear (when config.yaml has pm.tool: linear)
# =============================================================================
# Get API key at: https://linear.app/settings/api
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=

# =============================================================================
# GitHub (optional - only needed for GitHub MCP, not gh CLI)
# =============================================================================
# GITHUB_TOKEN=
