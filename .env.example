# SDLC Framework Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: This file contains SECRETS - never commit .env to git
# Project preferences (non-secret) go in config.yaml
RALPH_LABEL=ralph-0

# =============================================================================
# Asana (when config.yaml has pm.tool: asana)
# =============================================================================
# Get your token at: https://app.asana.com/0/developer-console
# ASANA_ACCESS_TOKEN=
# ASANA_WORKSPACE_ID=
# ASANA_PROJECT_ID=

# =============================================================================
# GITLAB (when config.yaml has pm.tool: gitlab)
# To create a GitLab Personal Access Token:                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
#   1. Go to your GitLab instance (e.g., https://gitlab.yourcompany.com)                                                                                                                                                                                                   
#   2. Navigate to Access Tokens:                                                                                                                                                                                                                                          
#     - Click your avatar (top-right) → Preferences                                                                                                                                                                                                                        
#     - Left sidebar → Access Tokens                                                                                                                                                                                                                                       
#     - Or direct URL: https://gitlab.yourcompany.com/-/user_settings/personal_access_tokens                                                                                                                                                                               
#   3. Create the token:                                                                                                                                                                                                                                                   
#     - Token name: Something like glab-cli or sdlc-workflow                                                                                                                                                                                                               
#     - Expiration date: Set as needed (or leave blank for no expiry)                                                                                                                                                                                                      
#     - Scopes needed for MR operations:                                                                                                                                                                                                                                   
#         - api (full access - simplest option)                                                                                                                                                                                                                            
#       - Or more restrictive: read_api + write_repository                                                                                                                                                                                                                 
#   4. Copy the token - you'll only see it once!                                                                                                                                                                                                                           
#   5. Use with glab:                                                                                                                                                                                                                                                      
#   glab auth login --hostname gitlab.yourcompany.com                                                                                                                                                                                                                      
#   5. When prompted, paste the token.     
# =============================================================================
# GITLAB_HOST=gitlab.yourcompany.com                                                                                                                                                                
# GITLAB_TOKEN=<personal-access-token>  

# =============================================================================
# Trello (when config.yaml has pm.tool: trello)
# =============================================================================
# Get API key at: https://trello.com/app-key
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_BOARD_ID=

